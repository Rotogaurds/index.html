<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>RotoGaurds</title>
  <style>
    body {
      background: #111;
      color: #fff;
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0; padding: 0;
    }
    header {
      background: #181818;
      padding: 1rem 2rem;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo {
      font-size: 2rem;
      font-weight: bold;
      color: #2196f3; /* Trust Blue */
      letter-spacing: 2px;
    }
    .products {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
      margin: 3rem 0;
    }
    .product-tile {
      background: #222;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      width: 250px;
      transition: transform 0.2s, box-shadow 0.2s;
      cursor: pointer;
      overflow: hidden;
      border: 2px solid #2196f3;
    }
    .product-tile:hover {
      transform: scale(1.07);
      box-shadow: 0 6px 24px rgba(33,150,243,0.3);
      border-color: #00bcd4; /* Accent Blue */
    }
    .product-image {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #333;
    }
    .product-info {
      padding: 1rem;
      color: #eee;
    }
    .product-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #fff;
    }
    .product-price {
      color: #00bcd4;
      font-size: 1.1rem;
      margin-top: 0.5rem;
    }
    .checkout-summary {
      display: none;
      position: fixed;
      top: 10%; left: 50%; transform: translateX(-50%);
      background: #181818;
      border-radius: 12px;
      box-shadow: 0 4px 24px rgba(33,150,243,0.4);
      padding: 2rem;
      z-index: 1000;
      color: #fff;
      min-width: 300px;
    }
    .checkout-summary.active {
      display: block;
    }
    .close-btn {
      background: #2196f3;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.5rem 1rem;
      cursor: pointer;
      float: right;
    }
    .buy-btn {
      background: #00bcd4;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.7rem 1.5rem;
      margin-top: 1rem;
      cursor: pointer;
      font-size: 1rem;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <header>
    <span class="logo">RotoGaurds</span>
    <!-- Nav can go here -->
  </header>
  <main>
    <section class="products">
      <div class="product-tile" onclick="showCheckout('Product 1', '$99')">
        <img class="product-image" src="https://via.placeholder.com/250x180.png?text=Product+1" alt="Product 1" />
        <div class="product-info">
          <div class="product-title">Product 1</div>
          <div class="product-price">$99</div>
        </div>
      </div>
      <div class="product-tile" onclick="showCheckout('Product 2', '$149')">
        <img class="product-image" src="https://via.placeholder.com/250x180.png?text=Product+2" alt="Product 2" />
        <div class="product-info">
          <div class="product-title">Product 2</div>
          <div class="product-price">$149</div>
        </div>
      </div>
      <!-- Add more products as needed -->
    </section>
    <div class="checkout-summary" id="checkout">
      <button class="close-btn" onclick="closeCheckout()">X</button>
      <h2 id="checkout-title"></h2>
      <p id="checkout-price"></p>
      <p>This is a demo checkout summary. Integrate payment here.</p>
      <button class="buy-btn">Buy Now</button>
    </div>
  </main>
  <script>
    function showCheckout(title, price) {
      document.getElementById('checkout-title').innerText = title;
      document.getElementById('checkout-price').innerText = price;
      document.getElementById('checkout').classList.add('active');
    }
    function closeCheckout() {
      document.getElementById('checkout').classList.remove('active');
    }
  </script>
</body>
</html>
